// factorio-worlds: members of the '@FW_USER@' group may start, stop and restart
// the world services without sudo (used by `factorio-worlds switch`), and the
// watcher may start the map render when the last player leaves.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.isInGroup("@FW_USER@")) {
        var unit = action.lookup("unit") || "";
        var verb = action.lookup("verb") || "";
        if (/^factorio(-notifier|-render)?@[a-z0-9_-]+\.service$/.test(unit) &&
            ["start", "stop", "restart"].indexOf(verb) >= 0) {
            return polkit.Result.YES;
        }
    }
});
