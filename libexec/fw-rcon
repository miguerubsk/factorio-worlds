#!/usr/bin/env python3
"""Minimal RCON client (Source RCON protocol, as spoken by Factorio).

Usage: FW_RCON_PASSWORD=... fw-rcon HOST PORT COMMAND
The password comes from the environment so it never shows up in `ps`.
Exit codes: 0 ok, 1 connection/protocol error, 2 bad usage, 3 wrong password.
"""
import os
import socket
import struct
import sys

SERVERDATA_AUTH = 3
SERVERDATA_EXECCOMMAND = 2
SERVERDATA_AUTH_RESPONSE = 2


def send(sock, req_id, req_type, body):
    payload = body.encode("utf-8") + b"\x00\x00"
    sock.sendall(struct.pack("<iii", len(payload) + 8, req_id, req_type) + payload)


def read_exact(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("connection closed by server")
        buf += chunk
    return buf


def receive(sock):
    (size,) = struct.unpack("<i", read_exact(sock, 4))
    data = read_exact(sock, size)
    req_id, req_type = struct.unpack("<ii", data[:8])
    return req_id, req_type, data[8:-2].decode("utf-8", errors="replace")


def main():
    if len(sys.argv) != 4:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    host, port, command = sys.argv[1], int(sys.argv[2]), sys.argv[3]
    password = os.environ.get("FW_RCON_PASSWORD", "")

    try:
        with socket.create_connection((host, port), timeout=5) as sock:
            send(sock, 1, SERVERDATA_AUTH, password)
            while True:
                req_id, req_type, _ = receive(sock)
                if req_type == SERVERDATA_AUTH_RESPONSE:
                    break
            if req_id == -1:
                print("rcon: authentication failed", file=sys.stderr)
                return 3
            send(sock, 2, SERVERDATA_EXECCOMMAND, command)
            _, _, body = receive(sock)
            if body:
                print(body.rstrip("\n"))
    except (OSError, ConnectionError, struct.error) as exc:
        print(f"rcon: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
