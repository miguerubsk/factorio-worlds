# factorio-worlds — settings shared by every world.
# Any key can be overridden in a world's own .env ($FW_ROOT/<world>/.env).
# Format: KEY=value, no spaces around '='. Quotes are optional.

# ── Network ─────────────────────────────────────────────────────────────────
# All worlds use the same ports: only one runs at a time.
GAME_PORT=34197
RCON_PORT=27015
# install.sh replaces this with a random password on first install.
RCON_PASSWORD=change-me
# Interface RCON listens on. Empty = all (0.0.0.0). 127.0.0.1 if only this
# machine uses RCON (factorio-worlds itself only needs local access).
RCON_BIND=127.0.0.1

# ── Backups ─────────────────────────────────────────────────────────────────
# Where update/remove keep their backups (default: $FW_ROOT/backups)
#BACKUP_DIR=/opt/factorio/backups

# ── Telegram notifications (optional: empty token = disabled) ───────────────
TELEGRAM_TOKEN=
# Space- or comma-separated chat IDs
TELEGRAM_CHAT_IDS=

# Message templates (Telegram HTML). Placeholders: {player} {world} {name}
# {ip} {old} {new} {time}. Uncomment to translate or customise.
#MSG_CONNECTING='🔌 Someone from <code>{ip}</code> is connecting to <b>{world}</b>...'
#MSG_JOIN='🚀 <b>{player}</b> joined <b>{world}</b>'
#MSG_LEAVE='💤 <b>{player}</b> left <b>{world}</b>'
#MSG_SWITCH='🔀 Server switched to <b>{name}</b> ({world})'
#MSG_UPDATE_START='🛠 Updating <b>{name}</b>: v{old} → v{new}...'
#MSG_UPDATE_DONE='✅ <b>{name}</b> updated to v{new}'
#MSG_UPDATE_FAIL='❌ Update of <b>{name}</b> to v{new} failed'
#MSG_RENDER_START='🗺️ Rendering the map of <b>{world}</b>...'
#MSG_RENDER_DONE='✅ Map of <b>{world}</b> updated in {time}'
#MSG_RENDER_FAIL='❌ Map render of <b>{world}</b> failed'

# ── Map render with mapshot (optional) ──────────────────────────────────────
# Needs mapshot (https://github.com/Palats/mapshot), a full (non-headless)
# Factorio client with the same mods as the world, and xvfb-run.
# The render user (install.sh --render-user, default: the service user) must be
# able to write to the client and output directories.
MAPSHOT_ENABLED=0
#MAPSHOT_BIN=/usr/local/bin/mapshot
#MAPSHOT_FACTORIO_DIR=/opt/factorio-client
#MAPSHOT_OUTPUT_DIR=/srv/www/factorio-maps
