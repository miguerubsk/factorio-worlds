# Settings of one world: $FW_ROOT/<world>/.env
# `factorio-worlds new` writes this file for you.

# Name shown in the server browser
DISPLAY_NAME="My world"
# Name used in notifications
WORLD_NAME="Nauvis"
# Main save: saves/<SAVE_NAME>.zip
SAVE_NAME="myworld"
# Daily map render (needs MAPSHOT_ENABLED=1 in the common .env)
RENDER=0
# Update this world's headless server with `factorio-worlds update`
UPDATE=1
# Only players in common/server-whitelist.json may join
#USE_WHITELIST=1
# Extra arguments for the Factorio server
#EXTRA_ARGS=""
# Any common key can be overridden, e.g.:
#TELEGRAM_CHAT_IDS=123456789
